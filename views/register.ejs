<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <title>Registreren - Limonee</title>
  <link rel="stylesheet" href="/style.css"> <!-- Zorg dat style.css bestaat in /public -->
</head>
<body>
  <%- include('partials/header') %>

  <div class="container">
<h2>Registreren</h2>
<% if (error) { %><p style="color:red"><%= error %></p><% } %>
  <form action="/register" method="post">
    <input name="username" placeholder="Gebruikersnaam" required><br>
    <input type="password" name="password" placeholder="Wachtwoord" required><br>
    <button type="submit">Registreer</button>
  </form>
  <p>Heb je al een account? <a href="/login">Log in</a></p>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
