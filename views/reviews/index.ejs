<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <title>Gebruikersreviews</title>
  <style>
    body { font-family: Arial; background: #f5f5f5; padding: 2rem; }
    .review { background: #fff; margin-bottom: 1rem; padding: 1rem; border-radius: 8px; box-shadow: 0 0 5px #ccc; }
    .stars { color: gold; }
    form { background: white; padding: 1rem; border-radius: 10px; box-shadow: 0 0 8px rgba(0,0,0,0.1); margin-top: 2rem; }
    input, select, textarea { width: 100%; padding: 0.5rem; margin-top: 0.5rem; margin-bottom: 1rem; }
    button { background: #ffcc00; border: none; padding: 0.7rem 1.2rem; border-radius: 6px; cursor: pointer; }
  </style>
</head>
<body>

  <h1>Gebruikersreviews</h1>

  <% reviews.forEach(review => { %>
    <div class="review">
      <strong><%= review.name %></strong><br />
      <div class="stars"><%= '★'.repeat(review.rating) + '☆'.repeat(5 - review.rating) %></div>
      <p><%= review.message %></p>
    </div>
  <% }) %>

</body>
</html>
