    <body>
   <%- include('../../partials/header') %>
        <h2>
            Bestellingen
        </h2>
        <h3 id="h33-1">
            Bestel limonade
        </h3>
        <p id="par3-2">Bestel (geef uw smaak door in het extra bericht): </p>
        <div class="container">
<form
  action="https://formsubmit.co/info@limonee.be"
  method="POST"
      onsubmit="handleSubmit(event)"
><input type="hidden" name="_next" value="https://limonee.be/">
  <label>
    Email:
    <input type="email" name="email" required>
  </label>
  <label>
    Naam:
    <input name="name" required>
  </label>
          <label for="aantal">Aantal liters(1 liter = 4 bekers, 1 liter = €3.50):</label>
        <input type="number" id="aantal" name="aantal" min="1" max="50" required>
          <input type="hidden" id="willekeurigeCode" name="willekeurigeCode">
  <label for="datum">Dag dat u het komt halen:</label>
          <select id="datum" name="datum" required>
  </select>
    <label for="aantal">Extra bericht(optioneel):</label>
  <textarea  id="bericht" name="bericht"></textarea>

  <!-- your other form fields go here -->
  <button onclick="submitbestelling()" type="submit">Send</button>
</form>

        </div>
      </div>
      <p>
        Als de bestelling word doorgegeven zal u een bericht krijgen met uw unieke code. Deze kan u ingeven bij het kraampje. 
      </p>
            <p>
              <strong>
       Voor een bestelling moet u zelf flessen meenemen.
                </strong>
      </p>
            <p>
Als u op een andere dag wilt bestellen, kan je ons een bericht sturen via het contactformulier. 
              <a href="/contact">
       Contact
                </a>
Onthoud dat de kans klein is dat het mogelijk is!
      </p>
      <br>
      <br>
      <br>
      <br>
      <script src="../../script.js"></script>
          <script>
        function generateRandomCode() {
            // Genereer een willekeurige code (bijvoorbeeld een 6-cijferige code)
            const randomCode = Math.floor(100000 + Math.random() * 900000);
            document.getElementById('willekeurigeCode').value = randomCode;
        }

        function handleSubmit(event) {
            // Genereer een nieuwe willekeurige code voordat het formulier wordt verzonden
            generateRandomCode();
        }
 function submitbestelling() {
  const aantal = parseInt(document.getElementById("aantal").value);
  const status = document.getElementById("status"); // Zorg dat je dit element hebt in je HTML

  let badges = JSON.parse(localStorage.getItem("badges")) || [];

  if (aantal >= 5) {
    const hasBesteller = badges.includes("besteller");

    if (!hasBesteller && !hasGroothandelaar) {
      status.textContent = "Bedankt voor je bestelling! 🎉 Je hebt de Besteller Badge gekregen.";
      badges.push("besteller");
    } else {
      status.textContent = "Bedankt voor je bestelling! 🎉";
    }

    localStorage.setItem("badges", JSON.stringify(badges));
  } else {
    status.textContent = "Bedankt voor je bestelling!";
  }
}
    </script>
      <script src="https://formspree.io/js/formbutton-v1.min.js" defer></script>

    </body>
<%- include('../../partials/footer') %>
</html>
