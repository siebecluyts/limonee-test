=<!DOCTYPE html>
<html>
<head>
  <title>Inloggen - Limonee</title>
</head>
<body>
  <%- include('partials/header', { user: null }) %>

<h2>Login</h2>
<% if (error) { %><p style="color:red"><%= error %></p><% } %>
<form method="POST">
  Gebruikersnaam: <input name="username" required><br>
  Wachtwoord: <input type="password" name="password" required><br>
  <button type="submit">Login</button>
</form>
<a href="/register">Nog geen account? Registeren</a>
  <%- include('partials/footer', { user: null }) %>
</body>
</html>
