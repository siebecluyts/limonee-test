=<!DOCTYPE html>
<html>
<head>
  <title>Inloggen - Limonee</title>
</head>
<body>
  <%- include('partials/header', { user: null }) %>

<h2>Login</h2>
<% if (error) { %><p style="color:red"><%= error %></p><% } %>
  <form action="/login" method="post">
    <input name="username" placeholder="Gebruikersnaam" required><br>
    <input type="password" name="password" placeholder="Wachtwoord" required><br>
    <button type="submit">Login</button>
  </form>
  <p>Nog geen account? <a href="/register">Registreren</a></p>
  <%- include('partials/footer', { user: null }) %>
</body>
</html>
